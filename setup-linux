#!/usr/bin/env bash
# Bootstrap script — run this on a fresh headless Linux box (Ubuntu/Debian).
# Usage: curl -fsSL https://raw.githubusercontent.com/radiosilence/dotfiles/main/setup-linux | bash
#
# bash, not zsh: zsh isn't installed yet. Only GitHub auth waits on a person;
# everything else is declared in config.d/mise and applied by
# `mise bootstrap`, which installs the apt packages, links the configs, makes
# zsh the login shell and installs the tools.
#
# No casks and no 1Password: a headless box has no GUI to run the app, so git
# auth goes through gh's credential helper over HTTPS and secrets stay on the
# machines that have the desktop agent.
#
# The script arrives on stdin, so commands that prompt read the terminal
# instead, or they would consume the rest of the script.
set -e

DOTFILES="$HOME/.dotfiles"
REPO=https://github.com/radiosilence/dotfiles.git

OK=$'\033[32m󰄬\033[0m'
WARN=$'\033[33m\033[0m'
WORK=$'\033[35m󱁤\033[0m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

printf "\n  %s\033[35m⟢%s %sdotfiles bootstrap (linux)%s\n\n" "$BOLD" "$RESET" "$BOLD" "$RESET"

# ---------------------------------------------------------------------------
# 1. What it takes to reach mise: curl for its installer, git for the clone,
#    and gh from apt. gh's credential helper records the path of the binary
#    that set it up, and /usr/bin/gh outlives mise's versioned install paths.
#    The rest of the apt list is in conf.d/04-packages.toml.
# ---------------------------------------------------------------------------
if ! command -v curl >/dev/null || ! command -v git >/dev/null || ! command -v gh >/dev/null; then
  printf "  %s installing curl, git and gh (sudo)\n" "$WORK"
  sudo apt-get update -qq
  sudo apt-get install -y -qq curl ca-certificates git gh
fi
printf "  %s curl, git, gh\n" "$OK"

# ---------------------------------------------------------------------------
# 2. GitHub auth before mise touches the network: nearly every tool in
#    03-tools.toml is a GitHub release, and the anonymous rate limit runs out
#    long before the list does. Device flow: gh prints a code you paste on
#    whatever machine you're sitting at, so a box with no browser works.
# ---------------------------------------------------------------------------
if ! gh auth status &>/dev/null; then
  printf "  %s authenticating gh (device flow — no browser needed here)\n" "$WARN"
  gh auth login --hostname github.com --git-protocol https --web </dev/tty
fi
gh auth setup-git
GITHUB_TOKEN="$(gh auth token)"
export GITHUB_TOKEN
printf "  %s gh authed\n" "$OK"

# ---------------------------------------------------------------------------
# 3. mise, from its installer into ~/.local/bin, where `upd` self-updates it.
# ---------------------------------------------------------------------------
export PATH="$HOME/.local/bin:$PATH"
if ! command -v mise >/dev/null; then
  printf "  %s installing mise\n" "$WORK"
  curl -fsSL https://mise.run | sh
fi
printf "  %s mise\n" "$OK"

# ---------------------------------------------------------------------------
# 4. Clone the repo, link ~/.config/mise to config.d/mise in it, and apply
#    it. HTTPS stays HTTPS: the SSH key lives in the 1Password desktop agent.
#    A re-run applies the existing checkout.
# ---------------------------------------------------------------------------
printf "  %s mise bootstrap\n\n" "$WORK"
cd "$HOME"
if [ -d "$DOTFILES/.git" ]; then
  if [ ! -e "$HOME/.config/mise" ]; then
    mkdir -p "$HOME/.config"
    ln -s "$DOTFILES/config.d/mise" "$HOME/.config/mise"
  fi
  mise bootstrap --yes </dev/tty
else
  mise bootstrap --yes --from "$REPO" --from-dir "$DOTFILES" --config-dir config.d/mise </dev/tty
fi

printf "\n  %s done. Log in again for zsh, then run %supd%s to keep things current.\n" "$OK" "$BOLD" "$RESET"
