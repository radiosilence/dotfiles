local rec fn=_${ZARG_NAME//[^a-zA-Z0-9]/_}
local -a all
local -a valued

for rec in "$ZARG_FLAGS[@]"; do all+=("$(_zarg_f "$rec" 1)" "$(_zarg_f "$rec" 2)"); done
for rec in "$ZARG_OPTS[@]"; do
  all+=("$(_zarg_f "$rec" 1)" "$(_zarg_f "$rec" 2)")
  valued+=("$(_zarg_f "$rec" 1)|$(_zarg_f "$rec" 2)${ZARG_SEP}$(_zarg_f "$rec" 7)")
done
all+=(-h --help --version --completions)

print -r -- "# Generated by \`$ZARG_NAME --completions bash\` — regenerate with \`task generate:completions\`."
print -r -- "$fn() {"
print -r -- "  local cur prev"
print -r -- '  cur="${COMP_WORDS[COMP_CWORD]}"'
print -r -- '  prev="${COMP_WORDS[COMP_CWORD-1]}"'
print -r -- '  case "$prev" in'
print -r -- "    --completions) COMPREPLY=(\$(compgen -W \"zsh fish bash\" -- \"\$cur\")); return ;;"
for rec in "$valued[@]"; do
  local pair=${rec%%${ZARG_SEP}*} values=${rec#*${ZARG_SEP}}
  [[ -n $values ]] || continue
  print -r -- "    $pair) COMPREPLY=(\$(compgen -W \"$(_zarg_esc_bash "$values")\" -- \"\$cur\")); return ;;"
done
print -r -- '  esac'
print -r -- '  if [[ $cur == -* ]]; then'
print -r -- "    COMPREPLY=(\$(compgen -W \"${all[*]}\" -- \"\$cur\")); return"
print -r -- '  fi'

# Positional value sets, when the first one declares them.
local firstvals=
for rec in "$ZARG_ARGS[@]"; do firstvals=$(_zarg_f "$rec" 6); break; done
if [[ -n $firstvals ]]; then
  print -r -- "  if (( COMP_CWORD == 1 )); then"
  print -r -- "    COMPREPLY=(\$(compgen -W \"$(_zarg_esc_bash "$firstvals")\" -- \"\$cur\")); return"
  print -r -- "  fi"
fi
print -r -- '  COMPREPLY=($(compgen -f -- "$cur"))'
print -r -- "}"
print -r -- "complete -F $fn $ZARG_NAME"
