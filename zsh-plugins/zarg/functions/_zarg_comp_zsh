autoload -Uz _zarg_action_zsh _zarg_esc_zsh _zarg_f
local rec short long i=1
local -a lines

for rec in "$ZARG_FLAGS[@]"; do
  short=$(_zarg_f "$rec" 1) long=$(_zarg_f "$rec" 2)
  lines+=("'($short $long)'{$short,$long}'[$(_zarg_esc_zsh "$(_zarg_f "$rec" 3)")]'")
done
for rec in "$ZARG_OPTS[@]"; do
  short=$(_zarg_f "$rec" 1) long=$(_zarg_f "$rec" 2)
  lines+=("'($short $long)'{$short,$long}'[$(_zarg_esc_zsh "$(_zarg_f "$rec" 3)")]$(_zarg_action_zsh "$(_zarg_f "$rec" 9)" "$(_zarg_f "$rec" 7)" "$(_zarg_f "$rec" 8)")'")
done
for rec in "$ZARG_ARGS[@]"; do
  local action=$(_zarg_action_zsh "$(_zarg_f "$rec" 1)" "$(_zarg_f "$rec" 6)" "$(_zarg_f "$rec" 7)")
  if (( $(_zarg_f "$rec" 4) )); then lines+=("'*${action}'")
  else                               lines+=("'${i}${action}'"); (( i++ ))
  fi
done

print -r -- "#compdef $ZARG_NAME"
print -r -- "# Generated by \`$ZARG_NAME --completions zsh\` — regenerate with \`task generate:completions\`."
print -r -- ""
print -r -- "_arguments -s \\"
for (( i = 1; i <= $#lines; i++ )); do print -r -- "  ${lines[i]} \\"; done
print -r -- "  '(-h --help)'{-h,--help}'[show help]' \\"
print -r -- "  '--version[show version]' \\"
print -r -- "  '--completions[emit completions]:shell:(zsh fish bash)'"
