#!/usr/bin/env zsh
# Wrapper shell for worktree tabs — auto-cleans or prompts on exit.
# Invoked by wtt, not by hand.

autoload -Uz zarg_init _wt_branches wt

zarg_init wt-shell 'Run a shell in a worktree tab, then remove the worktree on exit if it is clean'
zarg_arg worktree 'worktree path' required
zarg_arg branch 'branch name' required complete=_wt_branches
zarg_go "$@"

set -euo pipefail

wt="$worktree"
name="$branch"

dim=$'\033[2m'
bold=$'\033[1m'
yellow=$'\033[1;33m'
green=$'\033[1;32m'
red=$'\033[1;31m'
cyan=$'\033[1;36m'
reset=$'\033[0m'

# Set pane title
printf '\033]2;%s\033\\' "$name"

zsh -i || true

# Guard: never touch the main worktree
root=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
root="${root%/.git}"
if [[ "$wt" == "$root" ]]; then
  exit 0
fi

echo ""
echo "  ${bold}Exiting worktree session${reset}"

# Check for dirty state
dirty_files=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')

# A branch created with -b and never pushed has no upstream, so @{upstream}..HEAD
# errors and counts zero — reading as clean in the one case where commits are
# about to be lost. Fall back to the remote default branch.
if upstream=$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null); then
  unpushed=$(git -C "$wt" rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)
else
  base=$(git -C "$wt" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || echo refs/remotes/origin/main)
  unpushed=$(git -C "$wt" rev-list --count "${base##refs/remotes/}..HEAD" 2>/dev/null || echo 0)
fi

if (( dirty_files == 0 && unpushed == 0 )); then
  # Clean — just remove silently
  if git worktree remove "$wt" 2>/dev/null; then
    git -C "$root" branch -d "$name" 2>/dev/null
    echo "  ${green}✓${reset} removed ${bold}${name}${reset} ${dim}(clean)${reset}"
    sleep 0.5
  fi
  exit 0
fi

# Dirty — show warnings and prompt
if (( dirty_files > 0 )); then
  echo "  ${yellow}You have ${dirty_files} uncommitted file(s). These will be lost if you remove the worktree.${reset}"
fi
if (( unpushed > 0 )); then
  echo "  ${yellow}You have ${unpushed} unpushed commit(s). These will be lost if you remove the worktree.${reset}"
fi

echo ""
echo "  ${cyan}[1]${reset} ${bold}Keep worktree${reset}      ${dim}Stays at ${wt}${reset}"
echo "  ${cyan}[2]${reset} ${bold}Remove worktree${reset}    ${dim}All changes and commits will be lost.${reset}"
echo ""
printf "  ${dim}press 1 or 2${reset} "

while true; do
  # zsh spells bash's `read -n1` as -k1; -s keeps it off the screen
  read -rsk1 answer
  case "$answer" in
    1)
      echo ""
      echo "  ${dim}kept ${name}${reset}"
      break
      ;;
    2)
      echo ""
      if git worktree remove --force "$wt" 2>/dev/null; then
        git -C "$root" branch -D "$name" 2>/dev/null
        echo "  ${green}✓${reset} removed ${bold}${name}${reset}"
      else
        echo "  ${red}✗${reset} failed to remove"
        sleep 2
      fi
      break
      ;;
  esac
  # Ignore anything else — keep waiting
done
sleep 0.5
