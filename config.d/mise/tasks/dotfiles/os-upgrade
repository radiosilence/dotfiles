#!/usr/bin/env bash
#MISE description="Upgrade every system package on Linux (needs sudo; not part of upd)"
#MISE hide=true
# `upd` leaves apt alone on Linux so it never needs root there.
set -euo pipefail

if [ "$(uname)" != Linux ]; then
  echo "os-upgrade is for Linux; upd upgrades macOS packages" >&2
  exit 1
fi
if command -v apt-get >/dev/null; then
  sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoremove -y
elif command -v dnf >/dev/null; then
  sudo dnf update -y
fi
