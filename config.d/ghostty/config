theme = monokai-pro
background-opacity = 1
background-blur = 20
macos-titlebar-style = transparent
font-family = Geist Mono
font-size = 11
font-style = Regular
keybind = global:§=toggle_quick_terminal
quick-terminal-animation-duration = 0
macos-option-as-alt = true
keybind = alt+3=text:#
keybind = alt+2=text:€
keybind = alt+0=text:º
keybind = alt+minus=text:–
keybind = alt+shift+minus=text:—
keybind = shift+enter=text:\n
clipboard-paste-protection = false

# Cmd+K → Ctrl+L (form feed) so the focused shell inside zellij clears its own buffer.
keybind = cmd+k=text:\x0c


# New tabs/windows always start in $HOME — don't inherit CWD from parent.
working-directory = home
window-inherit-working-directory = false
tab-inherit-working-directory = false

cursor-click-to-move = true
notify-on-command-finish = unfocused
link-previews = true
confirm-close-surface = false

# Starts as one bare window; nothing is restored on launch.
window-save-state = never
resize-overlay = never
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

# cmd+left/right default to text:\x01 / \x05 (ctrl+a / ctrl+e), which a
# multiplexer can claim as a prefix. Home/End escape sequences carry no control
# byte; zsh binds them in conf.d/interactive.zsh.
keybind = super+arrow_left=text:\x1b[H
keybind = super+arrow_right=text:\x1b[F


# ssh: ghostty's TERM is xterm-ghostty, which no distro's ncurses ships — not
# even ncurses-term. A remote that can't look it up loses cub1 and redraws the
# line with \r instead of \b, so a prompt repainting per keystroke garbles and
# backspace dies. ssh-env sends xterm-256color + COLORTERM instead, which every
# box already understands. Not ssh-terminfo: that fixes it by tic'ing a file
# into ~/.terminfo on every host you ever touch, and the only capability zsh's
# line editor actually needs from terminfo is one xterm-256color already has.
shell-integration-features = ssh-env
