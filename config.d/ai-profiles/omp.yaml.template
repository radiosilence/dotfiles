# Which omp (Oh My Pi) profile to use, by working directory.
#
# Copy to omp.yaml (gitignored — it holds your private paths) and edit:
#   cp omp.yaml.template omp.yaml
#
# `omp` / `o` pick the profile whose longest matching `root` is a prefix of $PWD;
# with no match they use the one marked `default: true`. `profile` is the omp config
# dir (PI_CONFIG_DIR — resolved under $HOME, so keep it inside ~). `args` are extra
# launch flags. With no omp.yaml at all, `omp` just uses ~/.omp.
profiles:
  - profile: ~/.omp
    roots:
      - ~/workspace/your-work-org
  - profile: ~/.omp-personal
    default: true
