# Which Claude profile to use, by working directory.
#
# Copy to claude.yaml (gitignored — it holds your private paths) and edit:
#   cp claude.yaml.template claude.yaml
#
# `claude` / `c` pick the profile whose longest matching `root` is a prefix of $PWD;
# with no match they use the one marked `default: true`. `profile` is the
# CLAUDE_CONFIG_DIR (isolated login/settings/MCP/sessions). `args` are extra launch
# flags for that profile. With no claude.yaml at all, `claude` just uses ~/.claude.
profiles:
  - profile: ~/.claude
    roots:
      - ~/workspace/your-work-org
  - profile: ~/.claude-personal
    default: true
    args: [--remote-control]   # personal-only; work orgs disable Remote Control
