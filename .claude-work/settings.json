{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude-work}/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "datadog@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "elixir-phoenix@oliver-kriska": true
  },
  "extraKnownMarketplaces": {
    "oliver-kriska": {
      "source": {
        "source": "github",
        "repo": "oliver-kriska/claude-elixir-phoenix"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "ghostty",
  "teammateMode": "in-process",
  "remoteControlAtStartup": true
}
