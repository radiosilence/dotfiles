#!/usr/bin/env zsh
# Bootstrap script — run this on a fresh macOS system.
# Usage: curl -fsSL https://raw.githubusercontent.com/radiosilence/dotfiles/main/setup-macos | zsh
#
# Only the steps that wait on a person live here: Xcode tools, Touch ID for
# sudo, GitHub auth and the 1Password agent. Everything else is declared in
# config.d/mise and applied by `mise bootstrap`, which installs Homebrew
# formulae and casks itself, so Homebrew is never installed.
#
# The script arrives on stdin, so commands that prompt read the terminal
# instead, or they would consume the rest of the script.
set -e

DOTFILES="$HOME/.dotfiles"
REPO=https://github.com/radiosilence/dotfiles.git

OK=$'\033[32m󰄬\033[0m'
WARN=$'\033[33m\033[0m'
WORK=$'\033[35m󱁤\033[0m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

print -P "\n  ${BOLD}\033[35m⟢${RESET} ${BOLD}dotfiles bootstrap${RESET}\n"

# ---------------------------------------------------------------------------
# 1. Xcode CLI Tools — git, and the compiler for formulae without a bottle.
#    /usr/bin/git exists before they are installed, so check xcode-select.
# ---------------------------------------------------------------------------
if ! xcode-select -p >/dev/null 2>&1; then
  print -P "  ${WARN} installing Xcode Command Line Tools (GUI prompt)"
  xcode-select --install 2>/dev/null || true
  until xcode-select -p >/dev/null 2>&1; do sleep 0.5; done
fi
print -P "  ${OK} xcode cli tools"

# ---------------------------------------------------------------------------
# 2. Touch ID for sudo — one password prompt now, biometric forever after.
#    mise uses sudo to create /opt/homebrew and to run pkg installers.
# ---------------------------------------------------------------------------
if ! sudo grep -q pam_tid /etc/pam.d/sudo_local 2>/dev/null; then
  print -P "  ${WARN} enabling Touch ID for sudo (enter password once)"
  sudo sh -c 'printf "auth       sufficient     pam_tid.so\n" > /etc/pam.d/sudo_local'
fi
print -P "  ${OK} touchid sudo"

# ---------------------------------------------------------------------------
# 3. mise, from its installer into ~/.local/bin, where `upd` self-updates it.
#    mise links the formulae it installs into /opt/homebrew/bin.
# ---------------------------------------------------------------------------
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"
if ! command -v mise >/dev/null 2>&1; then
  print -P "  ${WORK} installing mise"
  curl -fsSL https://mise.run | sh
fi
print -P "  ${OK} mise"

# ---------------------------------------------------------------------------
# 4. 1Password and a browser for the sign-ins below.
# ---------------------------------------------------------------------------
print -P "  ${WORK} installing 1Password and zen"
mise bootstrap packages apply --yes brew-cask:1password brew-cask:1password-cli brew-cask:zen </dev/tty
print -P "  ${OK} 1password + zen"

# ---------------------------------------------------------------------------
# 5. GitHub auth before mise touches the network: nearly every tool in
#    03-tools.toml is a GitHub release, and the anonymous rate limit runs out
#    long before the list does. gh comes from mise until bootstrap installs
#    it, so the token is exported for this run.
# ---------------------------------------------------------------------------
gh() { mise exec gh@latest -- gh "$@"; }
if ! gh auth status &>/dev/null; then
  print -P "  ${WARN} authenticating gh"
  gh auth login --hostname github.com --git-protocol https --web </dev/tty
fi
GITHUB_TOKEN="$(gh auth token)"
export GITHUB_TOKEN
print -P "  ${OK} gh authed"

# ---------------------------------------------------------------------------
# 6. Block until the 1Password SSH agent is enabled. Git signing and the SSH
#    remote depend on it.
# ---------------------------------------------------------------------------
sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [[ ! -S "$sock" ]]; then
  print -P "  ${WARN} open 1Password → Settings → Developer, then enable:"
  print -P "         • ${BOLD}SSH Agent${RESET}"
  print -P "         • ${BOLD}Connect with 1Password CLI${RESET}"
  while [[ ! -S "$sock" ]]; do sleep 0.5; done
fi
print -P "  ${OK} 1password agent ready"

# ---------------------------------------------------------------------------
# 7. Clone the repo, link ~/.config/mise to config.d/mise in it, and apply
#    it. A re-run applies the existing checkout.
# ---------------------------------------------------------------------------
print -P "  ${WORK} mise bootstrap\n"
cd "$HOME"
if [[ -d "$DOTFILES/.git" ]]; then
  if [[ ! -e "$HOME/.config/mise" ]]; then
    mkdir -p "$HOME/.config"
    ln -s "$DOTFILES/config.d/mise" "$HOME/.config/mise"
  fi
  mise bootstrap --yes </dev/tty
else
  mise bootstrap --yes --from "$REPO" --from-dir "$DOTFILES" --config-dir config.d/mise </dev/tty
fi

print -P "\n  ${OK} done. Enable this machine's roles in ${BOLD}~/.config/mise/config.local.toml${RESET},"
print -P "     then run ${BOLD}upd${RESET} in a new terminal to install them and the App Store apps."
