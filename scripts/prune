#!/usr/bin/env zsh
# Find and delete small directories cluttering a tree.
set -o pipefail

autoload -Uz _dt_confirm _dt_err _dt_head _dt_info _dt_ok _dt_warn \
             zarg_arg zarg_flag zarg_go zarg_init zarg_opt

zarg_init prune 'Find and delete small directories'
zarg_flag -y --yes      'delete without confirmation'
zarg_opt  -s --min-size 'directories smaller than this are candidates, in KB' default=3072 env=MIN_SIZE metavar=KB
zarg_arg  paths 'directories to search' variadic default=.
zarg_go "$@"

DT_YES=$yes

# 1024-based, largest unit that fits, 2 decimal places (whole B stays bare).
_human() {
  local bytes=$1
  local -a units=(B KB MB GB)
  local u=1
  while (( bytes >= 1024 && u < $#units )); do bytes=$(( bytes / 1024.0 )); (( u++ )); done
  if (( u == 1 )); then print -r -- "${bytes} ${units[u]}"
  else printf '%.2f %s\n' "$bytes" "${units[u]}"; fi
}

_dt_head prune
_dt_info "threshold: $(_human $(( min_size * 1024 )))"

local -a candidates=()
local dir size
local p
for p in $paths; do
  while IFS= read -r -d $'\0' dir; do
    size=$(du -sk "$dir" 2>/dev/null | cut -f1)
    [[ -n $size ]] || continue
    (( size < min_size )) && candidates+=("$dir")
  done < <(find "$p" -mindepth 1 \( -name '.*' -prune \) -o -type d -print0 2>/dev/null)
done

candidates=("${(@f)$(print -rl -- "${candidates[@]}" | sort)}")

# Drop descendants of an already-kept candidate — deleting the parent takes
# the child with it.
local -a kept=()
local c last=
for c in $candidates; do
  [[ -n $last && $c == ${last}/* ]] && continue
  kept+=("$c"); last=$c
done

if (( ! $#kept )); then
  _dt_ok "No directories found below $(_human $(( min_size * 1024 )))"
  exit 0
fi

# Re-measure so the table reflects only survivors, sorted smallest first.
local -A sizes
local total=0 kb
for c in $kept; do
  kb=$(du -sk "$c" 2>/dev/null | cut -f1)
  sizes[$c]=$kb
  (( total += kb ))
done
kept=("${(@f)$(for c in $kept; do print -r -- "${sizes[$c]}"$'\t'"$c"; done | sort -n | cut -f2)}")

_dt_info "Found $#kept candidates"
print -r -- ""
printf '  %-50s %12s\n' PATH SIZE
printf '  %s\n' "${(l:64::─:)}"
local display
for c in $kept; do
  if (( $#c > 48 )); then display="...${c[-45,-1]}"; else display=$c; fi
  printf '  %-50s %12s\n' "$display" "$(_human $(( sizes[$c] * 1024 )))"
done

print -r -- ""
_dt_info "total: $(_human $(( total * 1024 )))"
print -r -- ""

_dt_confirm 'Delete these directories?' || { _dt_warn "Operation cancelled"; exit 0 }

print -r -- ""
local failed=0 err
for c in $kept; do
  if err=$(rm -rf "$c" 2>&1 >/dev/null); then
    _dt_ok "$c"
  else
    _dt_err "$c: $err"; (( failed++ ))
  fi
done

print -r -- ""
_dt_ok "Deleted $(( $#kept - failed )) directories"
