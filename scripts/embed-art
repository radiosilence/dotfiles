#!/usr/bin/env zsh
# Embed cover/disc/back/artist art from each FLAC's own directory.
set -o pipefail

autoload -Uz zarg _dt_cores _dt_err _dt_fan _dt_files _dt_head \
             _dt_info _dt_need _dt_ok _dt_step _dt_warn

zarg embed-art 'Embed artwork into FLAC files'
zarg_arg paths 'directories to search' variadic default=.
zarg_go "$@"

_dt_need metaflac clean-exif || exit 1
_dt_head embed-art

_dt_info "paths: ${(j:, :)paths}"
_dt_info "cores: $(_dt_cores)"

# Embedded art carries its own EXIF into the FLAC otherwise.
_dt_step "cleaning exif data from images"
local p
for p in $paths; do clean-exif "$p" >/dev/null; done

local -a flacs=(${(0)"$(_dt_files flac "${paths[@]}")"})
_dt_info "flac files: $#flacs"
(( $#flacs )) || exit 0

# Per FLAC: pick the first match in each art category (front/disc/back/artist),
# embed into a tmp copy, and only swap it in if every embed succeeded — a
# half-embedded FLAC must never replace a good one.
local snippet='
f="$1"; dir=$(dirname "$f"); base=$(basename "$f"); tmp="$f.tmp"

front=""
for n in cover.jpg folder.jpg album.jpg front.jpg cover.png folder.png album.png front.png; do
  [ -f "$dir/$n" ] && { front="$dir/$n"; break; }
done

disc=""
for n in cd.jpg disc.jpg cd.png disc.png; do
  [ -f "$dir/$n" ] && { disc="$dir/$n"; break; }
done

back=""
for n in back.jpg backcover.jpg back.png backcover.png; do
  [ -f "$dir/$n" ] && { back="$dir/$n"; break; }
done

artist=""
for n in artist.jpg band.jpg artist.png band.png; do
  [ -f "$dir/$n" ] && { artist="$dir/$n"; break; }
done

if [ -z "$front$disc$back$artist" ]; then
  echo "none $base"
  exit 0
fi

cp "$f" "$tmp" || { echo "fail $base"; exit 0; }

ok=1
[ -n "$front" ]  && { metaflac --import-picture-from="3||||$front" "$tmp" >/dev/null 2>&1 || ok=0; }
[ -n "$disc" ]   && { metaflac --import-picture-from="6||||$disc" "$tmp" >/dev/null 2>&1 || ok=0; }
[ -n "$back" ]   && { metaflac --import-picture-from="4||||$back" "$tmp" >/dev/null 2>&1 || ok=0; }
[ -n "$artist" ] && { metaflac --import-picture-from="8||||$artist" "$tmp" >/dev/null 2>&1 || ok=0; }

if [ "$ok" = 1 ]; then
  mv "$tmp" "$f"
  echo "ok $base"
else
  rm -f "$tmp"
  echo "fail $base"
fi
'

local -a out=(${(f)"$(printf '%s\0' $flacs | _dt_fan "$snippet")"})

local embedded=0 failed=0 line kind name
for line in $out; do
  kind=${line%% *}
  name=${line#* }
  case $kind in
    ok)   _dt_ok "$name"; (( embedded++ )) ;;
    fail) _dt_err "$name"; (( failed++ )) ;;
    none) _dt_warn "no artwork found: $name" ;;
  esac
done

print -r -- ""
_dt_info "embedded: $embedded"
if (( failed )); then
  _dt_info "failed: $failed"
  exit 1
fi
