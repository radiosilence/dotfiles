#!/usr/bin/env zsh
# Strip EXIF (and XMP/IPTC/ICC) metadata from images before sharing them.
set -o pipefail

autoload +X -Uz zarg dt || exit 1

zarg clean-exif 'Strip EXIF metadata from images'
zarg_flag -n --dry-run 'show what would be cleaned'
zarg_arg  paths 'directories to search' variadic default=.
zarg_go "$@"

dt need exiftool || exit 1
dt head clean-exif

local -a files=(${(0)"$(dt files 'jpg jpeg png' $paths)"})
(( $#files )) || { dt warn "No image files found"; exit 0 }

dt info "Found: $#files images"
dt info "Cores: $(dt cores)"
dt info "Stripping: all EXIF metadata"
print -r -- ""

if (( dry_run )); then
  dt info "Dry run - files that would be cleaned:"
  local f
  for f in $files; do print -r -- "    $f"; done
  exit 0
fi

# -all= rather than a raw EXIF-chunk strip: it also clears XMP, IPTC and ICC
# sidecar data that hand-rolled EXIF removal misses. exiftool batches many
# files in one process, so pass the whole list at once rather than fanning
# out a process per file. -q -q leaves exiftool's own "Error:" lines as the
# only output, one per failed file, so those are what we count against.
local out
out=$(exiftool -all= -overwrite_original -q -q $files 2>&1)
local failed=$(print -r -- "$out" | grep -c '^Error:')
local ok=$(( $#files - failed ))

[[ -n $out ]] && print -r -- "$out"
print -r -- ""
dt results $ok $failed Cleaned
